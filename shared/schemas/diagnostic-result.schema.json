{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-net-skill.dev/schemas/diagnostic-result.schema.json",
  "title": "Diagnostic Result",
  "type": "object",
  "required": ["observations", "derived_facts", "inferences", "hypotheses", "failure_boundary", "root_cause", "evidence", "next_checks"],
  "additionalProperties": false,
  "properties": {
    "procedure": {"type": ["string", "null"]}, "subscriber": {"type": ["object", "null"]}, "session": {"type": ["object", "null"]},
    "network_functions": {"type": "array", "items": {"type": "string"}}, "interfaces": {"type": "array", "items": {"type": "string"}}, "protocols": {"type": "array", "items": {"type": "string"}}, "timeline": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "string"}}, "derived_facts": {"type": "array", "items": {"type": "string"}}, "inferences": {"type": "array", "items": {"type": "string"}}, "hypotheses": {"type": "array", "items": {"type": "string"}},
    "failure_boundary": {"type": "object", "required": ["status", "description", "confidence"], "additionalProperties": false, "properties": {"status": {"type": "string", "enum": ["UNKNOWN", "SUSPECTED", "PROBABLE", "CONFIRMED"]}, "description": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "root_cause": {"type": "object", "required": ["status", "description", "confidence"], "additionalProperties": false, "properties": {"status": {"type": "string", "enum": ["UNCONFIRMED", "HYPOTHESIS", "CONFIRMED"]}, "description": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "evidence": {"type": "array", "items": {"type": "object"}}, "next_checks": {"type": "array", "items": {"type": "string"}}, "recommended_capture_points": {"type": "array", "items": {"type": "string"}}, "recommended_log_points": {"type": "array", "items": {"type": "string"}}, "recommended_source_locations": {"type": "array", "items": {"type": "string"}}
  }
}
