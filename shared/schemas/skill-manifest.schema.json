{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-net-skill.dev/schemas/skill-manifest.schema.json",
  "title": "Skill Manifest",
  "type": "object",
  "required": ["name", "version", "category", "description", "scope", "dependencies", "inputs", "outputs", "evidence_levels", "upstream", "testing"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "category": {"type": "string", "enum": ["foundation", "protocol", "domain", "implementation", "orchestration"]},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["includes", "excludes"], "additionalProperties": false, "properties": {"includes": {"type": "array", "items": {"type": "string"}}, "excludes": {"type": "array", "items": {"type": "string"}}}},
    "dependencies": {"type": "object", "required": ["required", "optional"], "additionalProperties": false, "properties": {"required": {"type": "array", "items": {"type": "string"}}, "optional": {"type": "array", "items": {"type": "string"}}}},
    "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}},
    "protocols": {"type": "array", "items": {"type": "string"}}, "interfaces": {"type": "array", "items": {"type": "string"}}, "network_functions": {"type": "array", "items": {"type": "string"}},
    "evidence_levels": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["OBSERVED", "DERIVED", "INFERRED", "HYPOTHESIS", "CONFIRMED"]}},
    "upstream": {"type": "object", "required": ["repository", "path", "commit", "license", "local_modifications"], "additionalProperties": false, "properties": {"repository": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}, "commit": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "local_modifications": {"type": "string"}}},
    "testing": {"type": "object", "required": ["fixtures", "expected_results"], "additionalProperties": false, "properties": {"fixtures": {"type": "array", "items": {"type": "string"}}, "expected_results": {"type": "array", "items": {"type": "string"}}}}
  }
}
