{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-net-skill.dev/schemas/diameter-event.schema.json",
  "title": "Bounded Diameter Base-Protocol Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_file",
    "frame_number",
    "frame_time_epoch",
    "message_occurrence",
    "protocol_version",
    "version_status",
    "message_length",
    "observed_message_length",
    "message_length_status",
    "command_code",
    "command_name",
    "command_scope",
    "application_id",
    "application_semantics",
    "flags",
    "direction",
    "hop_by_hop_id",
    "end_to_end_id",
    "transport",
    "avps",
    "avp_count",
    "avps_omitted",
    "result",
    "evidence_class",
    "limitations"
  ],
  "properties": {
    "capture_file": {"type": "string", "minLength": 1},
    "frame_number": {"type": "integer", "minimum": 1},
    "frame_time_epoch": {"type": ["string", "null"]},
    "message_occurrence": {"type": "integer", "minimum": 1},
    "protocol_version": {"type": ["integer", "null"]},
    "version_status": {"type": "string", "enum": ["SUPPORTED", "UNSUPPORTED"]},
    "message_length": {"type": ["integer", "null"]},
    "observed_message_length": {"type": ["integer", "null"]},
    "message_length_status": {"type": "string", "enum": ["VALID", "MISMATCH", "INVALID", "UNVERIFIED"]},
    "command_code": {"type": ["integer", "null"]},
    "command_name": {"type": ["string", "null"]},
    "command_scope": {"type": "string", "enum": ["BASE", "APPLICATION_OR_UNKNOWN"]},
    "application_id": {"type": ["integer", "null"]},
    "application_semantics": {"type": "string", "enum": ["BASE_COMMON_MESSAGES", "UNSUPPORTED"]},
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "proxyable", "error", "retransmitted"],
      "properties": {
        "request": {"type": "boolean"},
        "proxyable": {"type": "boolean"},
        "error": {"type": "boolean"},
        "retransmitted": {"type": "boolean"}
      }
    },
    "direction": {"type": "string", "enum": ["REQUEST", "ANSWER"]},
    "hop_by_hop_id": {"type": ["integer", "null"]},
    "end_to_end_id": {"type": ["integer", "null"]},
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "source_address", "source_port", "destination_address", "destination_port", "verification_tag", "stream_id", "association_index", "association_identity_status", "association_reference"],
      "properties": {
        "protocol": {"type": "string", "enum": ["TCP", "SCTP", "UNKNOWN"]},
        "source_address": {"type": ["string", "null"]},
        "source_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "destination_address": {"type": ["string", "null"]},
        "destination_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "verification_tag": {"type": ["string", "null"]},
        "stream_id": {"type": ["integer", "null"]},
        "association_index": {"type": ["integer", "null"], "minimum": 0},
        "association_identity_status": {"type": "string", "enum": ["DECODER_INDEX", "TCP_STREAM", "ENDPOINT_ONLY"]},
        "association_reference": {"type": "string", "minLength": 1}
      }
    },
    "avps": {"type": "array", "items": {"$ref": "#/$defs/avp"}},
    "avp_count": {"type": "integer", "minimum": 0},
    "avps_omitted": {"type": "integer", "minimum": 0},
    "result": {"$ref": "#/$defs/result"},
    "evidence_class": {"type": "string", "enum": ["OBSERVED", "DERIVED"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "avp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avp_reference",
        "code",
        "name",
        "name_reviewed",
        "occurrence_index",
        "depth",
        "vendor_specific",
        "mandatory",
        "protected",
        "vendor_id",
        "length",
        "data_present",
        "sensitive",
        "value",
        "value_kind",
        "grouping_status",
        "children_omitted",
        "children"
      ],
      "properties": {
        "avp_reference": {"type": "string", "minLength": 1},
        "code": {"type": ["integer", "null"]},
        "namespace": {"type": "string", "enum": ["BASE", "3GPP", "UNKNOWN_VENDOR", "INVALID_VENDOR"]},
        "name": {"type": ["string", "null"]},
        "name_reviewed": {"type": "boolean"},
        "occurrence_index": {"type": "integer", "minimum": 1},
        "depth": {"type": "integer", "minimum": 1},
        "vendor_specific": {"type": "boolean"},
        "mandatory": {"type": "boolean"},
        "protected": {"type": "boolean"},
        "vendor_id": {"type": ["integer", "null"]},
        "length": {"type": ["integer", "null"]},
        "data_present": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "value": {"type": ["string", "integer", "null"]},
        "value_kind": {"type": "string", "enum": ["STRING", "INTEGER", "OPAQUE", "GROUPED", "SENSITIVE_REDACTED"]},
        "grouping_status": {"type": "string", "enum": ["DECODED", "NOT_DECODED", "NOT_GROUPED", "DEPTH_LIMITED", "REDACTED", "UNKNOWN"]},
        "children_omitted": {"type": "integer", "minimum": 0},
        "children": {"type": "array", "items": {"$ref": "#/$defs/avp"}}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_code", "result_code_name", "result_namespace", "experimental_result_present", "experimental_result_code", "experimental_vendor_id"],
      "properties": {
        "result_status": {"type": "string", "enum": ["MISSING", "SINGLE_BASE", "SINGLE_EXPERIMENTAL", "CONFLICTING", "DUPLICATE"]},
        "result_code": {"type": ["integer", "null"]},
        "result_code_name": {"type": ["string", "null"]},
        "result_namespace": {"type": ["string", "null"], "enum": ["BASE", "VENDOR_SPECIFIC", null]},
        "experimental_result_present": {"type": "boolean"},
        "experimental_result_code": {"type": ["integer", "null"]},
        "experimental_vendor_id": {"type": ["integer", "null"]},
        "base_result_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name", "avp_reference"],
            "properties": {
              "code": {"type": "integer"},
              "name": {"type": ["string", "null"]},
              "avp_reference": {"type": ["string", "null"]}
            }
          }
        },
        "experimental_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor_id", "code", "group_reference", "code_reference", "vendor_reference"],
            "properties": {
              "vendor_id": {"type": ["integer", "null"]},
              "code": {"type": ["integer", "null"]},
              "group_reference": {"type": ["string", "null"]},
              "code_reference": {"type": ["string", "null"]},
              "vendor_reference": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}