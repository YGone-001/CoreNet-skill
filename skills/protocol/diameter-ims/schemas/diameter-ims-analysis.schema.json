{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-net-skill.dev/schemas/diameter-ims-analysis.schema.json",
  "title": "Bounded Diameter IMS Cx/Dx Application Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_name",
    "analysis_version",
    "domain",
    "capability",
    "input_provenance",
    "command_inventory",
    "observations",
    "completeness",
    "not_confirmed",
    "limitations"
  ],
  "properties": {
    "analysis_name": {"const": "diameter-ims"},
    "analysis_version": {"type": "string"},
    "domain": {"const": "protocol"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_commands",
        "recognized_unsupported_commands",
        "application_id",
        "application_name",
        "interface_identity",
        "interface_identity_basis",
        "unreviewed_command_policy"
      ],
      "properties": {
        "supported_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recognized_unsupported_commands": {"type": "array", "items": {"type": "string"}},
        "application_id": {"const": 16777216},
        "application_name": {"const": "Cx/Dx"},
        "interface_identity": {"const": "UNPROVED"},
        "interface_identity_basis": {"type": "array", "items": {"type": "string"}},
        "unreviewed_command_policy": {"const": "KNOWN_UNSUPPORTED_WITH_NUMERIC_IDENTITY"}
      }
    },
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_files", "event_count", "transaction_count", "events_sha256", "transactions_sha256"],
      "properties": {
        "capture_files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "event_count": {"type": "integer", "minimum": 1},
        "transaction_count": {"type": "integer", "minimum": 0},
        "events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transactions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "command_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_id",
          "command_code",
          "command_name",
          "direction",
          "event_count",
          "transaction_count",
          "scope"
        ],
        "properties": {
          "application_id": {"type": "integer"},
          "command_code": {"type": "integer"},
          "command_name": {"type": ["string", "null"]},
          "direction": {"type": "string", "enum": ["REQUEST", "ANSWER"]},
          "event_count": {"type": "integer", "minimum": 1},
          "transaction_count": {"type": "integer", "minimum": 0},
          "scope": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "KNOWN_UNSUPPORTED",
              "CONFLICTING_APPLICATION",
              "NON_CX_APPLICATION",
              "BASE_OR_UNKNOWN"
            ]
          }
        }
      }
    },
    "observations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/observation"}},
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_count",
        "observations_omitted",
        "cx_event_count",
        "cx_transaction_count",
        "events_with_avp_omissions",
        "truncated_observations",
        "unsupported_observations",
        "conflicting_observations",
        "observations_with_unproven_grouping"
      ],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 0},
        "observations_omitted": {"type": "integer", "minimum": 0},
        "cx_event_count": {"type": "integer", "minimum": 0},
        "cx_transaction_count": {"type": "integer", "minimum": 0},
        "events_with_avp_omissions": {"type": "integer", "minimum": 0},
        "truncated_observations": {"type": "integer", "minimum": 0},
        "unsupported_observations": {"type": "integer", "minimum": 0},
        "conflicting_observations": {"type": "integer", "minimum": 0},
        "observations_with_unproven_grouping": {"type": "integer", "minimum": 0}
      }
    },
    "not_confirmed": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_reference",
        "frame_number",
        "message_occurrence",
        "direction",
        "application_id",
        "command_code",
        "command_name",
        "message_name",
        "hop_by_hop_id",
        "end_to_end_id",
        "source_endpoint",
        "destination_endpoint"
      ],
      "properties": {
        "event_reference": {"type": "string", "minLength": 1},
        "frame_number": {"type": "integer", "minimum": 1},
        "message_occurrence": {"type": "integer", "minimum": 1},
        "direction": {"type": "string", "enum": ["REQUEST", "ANSWER"]},
        "application_id": {"type": "integer"},
        "command_code": {"type": "integer"},
        "command_name": {"type": ["string", "null"]},
        "message_name": {"type": ["string", "null"]},
        "hop_by_hop_id": {"type": ["integer", "null"]},
        "end_to_end_id": {"type": ["integer", "null"]},
        "source_endpoint": {"type": "string"},
        "destination_endpoint": {"type": "string"}
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "vendor_id",
        "occurrence_count",
        "sensitive",
        "reviewed_values",
        "value_published"
      ],
      "properties": {
        "code": {"type": "integer"},
        "name": {"type": ["string", "null"]},
        "vendor_id": {"type": ["integer", "null"]},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "sensitive": {"type": "boolean"},
        "reviewed_values": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "value_published": {"type": "boolean"}
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "vendor_id",
        "occurrence_count",
        "status",
        "sensitive",
        "grouped",
        "grouping_status",
        "structure_proven",
        "reviewed_values",
        "value_published",
        "children",
        "children_omitted"
      ],
      "properties": {
        "code": {"type": "integer"},
        "name": {"type": "string", "minLength": 1},
        "vendor_id": {"type": ["integer", "null"]},
        "occurrence_count": {"type": "integer", "minimum": 0},
        "status": {
          "type": "string",
          "enum": [
            "PRESENT",
            "PRESENT_REDACTED",
            "PRESENT_STRUCTURE_ONLY",
            "NOT_OBSERVED",
            "NOT_OBSERVED_IN_PUBLISHED_SUBSET"
          ]
        },
        "sensitive": {"type": "boolean"},
        "grouped": {"type": "boolean"},
        "grouping_status": {"type": ["string", "null"]},
        "structure_proven": {"type": "boolean"},
        "reviewed_values": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "value_published": {"type": "boolean"},
        "children": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/child"}},
        "children_omitted": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_result_status",
        "namespace_status",
        "application_result",
        "base_result_code",
        "base_result_code_name",
        "experimental_result_code",
        "experimental_result_code_name",
        "experimental_vendor_id",
        "base_results",
        "experimental_results",
        "limitations"
      ],
      "properties": {
        "core_result_status": {"type": "string", "enum": ["MISSING", "SINGLE_BASE", "SINGLE_EXPERIMENTAL", "CONFLICTING", "DUPLICATE"]},
        "namespace_status": {
          "type": "string",
          "enum": [
            "BASE_RFC6733",
            "3GPP_TS_29_229_EXPERIMENTAL",
            "UNKNOWN_VENDOR_EXPERIMENTAL",
            "MISSING",
            "CONFLICTING"
          ]
        },
        "application_result": {"type": "string", "enum": ["SUCCESS_REPORTED", "FAILURE_REPORTED", "UNRESOLVED", "NOT_APPLICABLE"]},
        "base_result_code": {"type": ["integer", "null"]},
        "base_result_code_name": {"type": ["string", "null"]},
        "experimental_result_code": {"type": ["integer", "null"]},
        "experimental_result_code_name": {"type": ["string", "null"]},
        "experimental_vendor_id": {"type": ["integer", "null"]},
        "base_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name", "avp_reference"],
            "properties": {
              "code": {"type": "integer"},
              "name": {"type": ["string", "null"]},
              "avp_reference": {"type": ["string", "null"]}
            }
          }
        },
        "experimental_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor_id", "code", "group_reference", "code_reference", "vendor_reference"],
            "properties": {
              "vendor_id": {"type": ["integer", "null"]},
              "code": {"type": ["integer", "null"]},
              "group_reference": {"type": ["string", "null"]},
              "code_reference": {"type": ["string", "null"]},
              "vendor_reference": {"type": ["string", "null"]}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_reference",
        "procedure",
        "procedure_family",
        "command_code",
        "command_name",
        "message_status",
        "transaction_status",
        "application_result",
        "request",
        "answer",
        "response_candidates",
        "latency_seconds",
        "transaction_reference",
        "result",
        "request_avp_presence",
        "answer_avp_presence",
        "limitations",
        "not_confirmed"
      ],
      "properties": {
        "observation_reference": {"type": "string", "minLength": 1},
        "procedure": {"type": ["string", "null"]},
        "procedure_family": {"type": ["string", "null"]},
        "command_code": {"type": "integer"},
        "command_name": {"type": ["string", "null"]},
        "message_status": {"type": "string", "enum": ["OBSERVED", "KNOWN_UNSUPPORTED", "CONFLICTING"]},
        "transaction_status": {"type": "string", "enum": ["MATCHED", "OPEN_REQUEST", "RESPONSE_ONLY", "AMBIGUOUS"]},
        "application_result": {"type": "string", "enum": ["SUCCESS_REPORTED", "FAILURE_REPORTED", "UNRESOLVED", "NOT_APPLICABLE"]},
        "request": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "answer": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "response_candidates": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "latency_seconds": {"type": ["string", "null"]},
        "transaction_reference": {"type": "string", "minLength": 1},
        "result": {"$ref": "#/$defs/result"},
        "request_avp_presence": {"type": "array", "items": {"$ref": "#/$defs/presence"}},
        "answer_avp_presence": {"type": "array", "items": {"$ref": "#/$defs/presence"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "not_confirmed": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}