{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corenet-skill.dev/schemas/orchestration/5gc-failure-boundary-analysis.schema.json",
  "title": "5GC Failure Boundary Orchestration Analysis",
  "description": "Bounded Analysis Orchestration output composing already-produced 5gc-registration-mobility, 5gc-pdu-session, and 5gc-handover-mobility Domain analysis summaries into evidence-safe diagnostic groups and identifying the earliest safely orderable abnormal evidence boundary per group. Handover and Path Switch attempts remain separately addressable source procedure units; a handover source/target context bridge is consumed only from a Domain-authorized STRONG or SUPPORTED association. The output carries no root_cause, culprit, responsible_nf, vendor_fault, implementation_failure, or bug_location fields and never claims network or procedure success.",
  "type": "object",
  "required": [
    "analysis_name",
    "analysis_version",
    "diagnostic_groups",
    "unbound_domain_analyses",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_name": {
      "type": "string",
      "const": "5gc-failure-boundary"
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosticGroup"
      }
    },
    "unbound_domain_analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unboundAnalysis"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "diagnosticGroup": {
      "type": "object",
      "required": [
        "diagnostic_id",
        "subject_link",
        "source_domain_instances",
        "observation_scope",
        "candidate_boundaries",
        "selection_status",
        "selected_boundary",
        "boundary_confidence",
        "earlier_context",
        "downstream_observations",
        "evidence_limitations",
        "additional_evidence_needed",
        "supporting_anomalies",
        "not_confirmed",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_link": {
          "$ref": "#/$defs/subjectLink"
        },
        "source_domain_instances": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "observation_scope": {
          "type": "object",
          "required": [
            "capture_files",
            "source_count"
          ],
          "additionalProperties": false,
          "properties": {
            "capture_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "candidate_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryCandidate"
          }
        },
        "selection_status": {
          "type": "string",
          "enum": [
            "SELECTED",
            "NO_ABNORMAL_BOUNDARY_OBSERVED",
            "AMBIGUOUS_FIRST_BOUNDARY",
            "INSUFFICIENT_COMPARABLE_EVIDENCE"
          ]
        },
        "selected_boundary": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "candidate_id",
            "boundary_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "boundary_ref": {
              "$ref": "#/$defs/boundaryCandidate"
            }
          }
        },
        "boundary_confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            null
          ]
        },
        "earlier_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedObservation"
          }
        },
        "downstream_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedObservation"
          }
        },
        "evidence_limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceDeviation"
          }
        },
        "additional_evidence_needed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reason",
              "requirement"
            ],
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "candidate_id": {
                "type": "string"
              },
              "second_candidate_id": {
                "type": "string"
              }
            }
          }
        },
        "supporting_anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceDeviation"
          }
        },
        "not_confirmed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subjectLink": {
      "type": "object",
      "required": [
        "strength",
        "basis",
        "source_contexts"
      ],
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "string",
          "enum": [
            "STRONG",
            "SUPPORTED",
            "AMBIGUOUS",
            "UNBOUND"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_contexts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "context_bridges": {
          "type": "array",
          "description": "Domain-authorized handover source/target context bridges active in this group. Present only when the Handover Domain itself established the association as STRONG or SUPPORTED and both context sides joined the group; association candidates are never used.",
          "items": {
            "type": "object",
            "required": [
              "source_domain",
              "source_instance_id",
              "bridge_type",
              "bridge_strength",
              "bridge_basis",
              "from_context",
              "to_context"
            ],
            "additionalProperties": false,
            "properties": {
              "source_domain": {
                "type": "string",
                "minLength": 1
              },
              "source_instance_id": {
                "type": "string",
                "minLength": 1
              },
              "bridge_type": {
                "type": "string",
                "minLength": 1
              },
              "bridge_strength": {
                "type": "string",
                "enum": [
                  "STRONG",
                  "SUPPORTED"
                ]
              },
              "bridge_basis": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "from_context": {
                "type": "object"
              },
              "to_context": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "boundaryCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "source_domain",
        "source_instance_id",
        "source_attempt_id",
        "procedure_family",
        "procedure_stage",
        "deviation_type",
        "description",
        "evidence_level",
        "boundary_anchor",
        "supporting_evidence",
        "ordering_basis",
        "selectability",
        "limitations",
        "mobility_attempt_family"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_domain": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "procedure_family": {
          "type": "string",
          "minLength": 1
        },
        "procedure_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviation_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "DERIVED"
          ]
        },
        "boundary_anchor": {
          "type": "object",
          "required": [
            "capture_file",
            "frame_number",
            "message_type",
            "protocol",
            "timestamp"
          ],
          "additionalProperties": false,
          "properties": {
            "capture_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "frame_number": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "timestamp": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "protocol": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "supporting_evidence": {
          "type": "object",
          "required": [
            "source_deviation",
            "source_observation_window",
            "source_terminal"
          ],
          "additionalProperties": false,
          "properties": {
            "source_deviation": {
              "type": "object"
            },
            "source_observation_window": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "first_frame": {
                  "type": "integer"
                },
                "last_frame": {
                  "type": "integer"
                }
              }
            },
            "source_terminal": {
              "type": "object"
            }
          }
        },
        "ordering_basis": {
          "type": "object",
          "required": [
            "frame_number",
            "observation_window",
            "stage_position"
          ],
          "additionalProperties": false,
          "properties": {
            "frame_number": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "observation_window": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "start_frame": {
                  "type": "integer"
                },
                "end_frame": {
                  "type": "integer"
                }
              }
            },
            "stage_position": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "selectability": {
          "type": "string",
          "enum": [
            "SELECTABLE",
            "BLOCKED_BY_PARTIAL_CAPTURE"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "mobility_attempt_family": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "handover",
            "path-switch",
            null
          ],
          "description": "Mobility attempt family when the source is a 5gc-handover-mobility attempt; null for Registration and PDU Session sources. Never merged across the two families."
        }
      }
    },
    "relatedObservation": {
      "type": "object",
      "required": [
        "relation"
      ],
      "additionalProperties": true,
      "properties": {
        "relation": {
          "type": "string",
          "enum": [
            "OBSERVED_AFTER_BOUNDARY",
            "OBSERVED_BEFORE_BOUNDARY"
          ]
        }
      }
    },
    "sourceDeviation": {
      "type": "object",
      "required": [
        "source_domain",
        "source_instance_id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "source_domain": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unboundAnalysis": {
      "type": "object",
      "required": [
        "source_domain",
        "source_instance_id",
        "source_file",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source_domain": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
