{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epc-release-narrative-analysis.schema.json",
  "title": "EPC release narrative and temporal evidence analysis",
  "description": "Bounded EPC session-level release narrative over accepted session-identity, bearer-lifecycle and S1-U evidence. Publishes hop-local narrative subjects, per-release stage narratives, frame-aware temporal partitions and the explicit refusals of the accepted evidence model. A release outcome, a release-to-session binding and a bearer-generation closure are separate facts; the release confirmation frame is never the forwarding-stop instant; an aggregate stream count is never divided across time windows. Never publishes subscriber identity and never selects an abnormal boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "domain_version",
    "analysis_name",
    "analysis_version",
    "input_provenance",
    "analysis_scope",
    "source_completeness",
    "narrative_subjects",
    "narrative_subject_count",
    "narrative_subjects_omitted",
    "release_narratives",
    "release_narrative_count",
    "release_narratives_omitted",
    "temporal_observations",
    "temporal_observation_count",
    "temporal_observations_omitted",
    "temporal_accounting",
    "ambiguous_associations",
    "ambiguous_association_count",
    "unbound_evidence",
    "unbound_evidence_count",
    "evidence_limitations",
    "additional_evidence_needed",
    "not_confirmed",
    "boundary_selection_status",
    "first_abnormal_boundary",
    "boundary_note"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "const": "epc-procedures"
    },
    "domain_version": {
      "type": "string"
    },
    "analysis_name": {
      "type": "string",
      "const": "epc-release-narrative"
    },
    "analysis_version": {
      "type": "string"
    },
    "input_provenance": {
      "type": "object"
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "stage_labels",
        "evidence_statuses",
        "subject_rule",
        "release_rule",
        "generation_rule",
        "temporal_rule",
        "completeness_rule"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "stage_labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage_label"
          }
        },
        "evidence_statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_status"
          }
        },
        "subject_rule": {
          "type": "string"
        },
        "release_rule": {
          "type": "string"
        },
        "generation_rule": {
          "type": "string"
        },
        "temporal_rule": {
          "type": "string"
        },
        "completeness_rule": {
          "type": "string"
        }
      }
    },
    "source_completeness": {
      "$ref": "#/$defs/source_completeness"
    },
    "narrative_subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/narrative_subject"
      }
    },
    "narrative_subject_count": {
      "type": "integer",
      "minimum": 0
    },
    "narrative_subjects_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "release_narratives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release_narrative"
      }
    },
    "release_narrative_count": {
      "type": "integer",
      "minimum": 0
    },
    "release_narratives_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "temporal_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporal_observation"
      }
    },
    "temporal_observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "temporal_observations_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "temporal_accounting": {
      "$ref": "#/$defs/temporal_accounting"
    },
    "ambiguous_associations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguous_record"
      }
    },
    "ambiguous_association_count": {
      "type": "integer",
      "minimum": 0
    },
    "unbound_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unbound_record"
      }
    },
    "unbound_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "additional_evidence_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_confirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_selection_status": {
      "type": "string",
      "const": "NOT_APPLICABLE"
    },
    "first_abnormal_boundary": {
      "type": "null"
    },
    "boundary_note": {
      "type": "string"
    }
  },
