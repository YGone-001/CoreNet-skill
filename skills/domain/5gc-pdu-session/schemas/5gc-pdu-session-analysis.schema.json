{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corenet-skill.dev/schemas/domain/5gc-pdu-session-analysis.schema.json",
  "title": "5GC PDU Session Analysis Summary",
  "description": "Bounded procedure-level analysis of one or more 5GC PDU Session Establishment procedure instances, composed from already-extracted N1 (NAS-5GS), N2 (NGAP), N3 (GTP-U), N4 (PFCP), and N11 (SBI-HTTP2) evidence. The analysis reports procedure stages, terminal observations, procedure-local deviations, and lower-layer field findings. It carries no root_cause, culprit, implementation_failure, or vendor bug fields.",
  "type": "object",
  "required": [
    "procedure_name",
    "procedure_version",
    "instances",
    "unbound_evidence",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "procedure_name": {
      "type": "string",
      "const": "5gc-pdu-session"
    },
    "procedure_version": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instanceAnalysis"
      }
    },
    "unbound_evidence": {
      "type": "object",
      "required": [
        "unbound_n1",
        "unbound_n2",
        "unbound_n3",
        "unbound_n4",
        "unbound_n11",
        "ambiguous_events"
      ],
      "additionalProperties": false,
      "properties": {
        "unbound_n1": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unbound_n2": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unbound_n3": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unbound_n4": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unbound_n11": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ambiguous_events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "instanceAnalysis": {
      "type": "object",
      "required": [
        "instance_id",
        "association_basis",
        "association_strength",
        "ue_context",
        "pdu_session_id",
        "stages",
        "terminal_observation",
        "deviations",
        "earliest_observed_deviation",
        "field_findings",
        "plane_bindings",
        "unbound_evidence",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "association_basis": {
          "type": "string",
          "minLength": 1
        },
        "association_strength": {
          "type": "string",
          "enum": [
            "STRONG",
            "SUPPORTED",
            "AMBIGUOUS",
            "UNBOUND"
          ]
        },
        "ue_context": {
          "type": "object",
          "required": [
            "ran_ue_ngap_id",
            "amf_ue_ngap_id",
            "sctp_association"
          ],
          "additionalProperties": false,
          "properties": {
            "ran_ue_ngap_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "amf_ue_ngap_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "sctp_association": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            }
          }
