                "object",
                "null"
              ]
            },
            "n11": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "unbound_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modification_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modificationAttempt"
          }
        },
        "release_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseAttempt"
          }
        },
        "session_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lifecycle_boundary_basis": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "previous_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reuse_status": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "capture_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observation_window": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "first_frame": {
              "type": "integer",
              "minimum": 1
