                "MISSING_EXPECTED_COUNTERPART",
                "CORRELATION_AMBIGUITY",
                "LIFECYCLE_AMBIGUITY",
                "CORRELATION_CONFLICT",
                "OUT_OF_ORDER_EVIDENCE",
                "PARTIAL_CAPTURE",
                "PROTECTED_OR_UNAVAILABLE_PAYLOAD",
                "UNKNOWN_OR_RESERVED_PROTOCOL_VALUE",
                "DUPLICATE_OR_RETRANSMITTED_EVIDENCE"
              ]
            },
            "stage_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence_level": {
              "type": "string",
              "enum": [
                "OBSERVED",
                "DERIVED"
              ]
            },
            "limitation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "field_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldFinding"
          }
        },
        "plane_bindings": {
          "type": "object",
          "required": [
            "n1",
            "n2",
            "n3",
            "n4",
            "n11"
          ],
          "additionalProperties": false,
          "properties": {
            "n1": {
              "type": [
                "object",
                "null"
              ]
            },
            "n2": {
              "type": [
                "object",
                "null"
              ]
            },
            "n3": {
              "type": [
                "object",
                "null"
              ]
            },
            "n4": {
