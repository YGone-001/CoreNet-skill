{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corenet-skill.local/schemas/ims-registration-analysis.schema.json",
  "title": "Bounded IMS registration Domain evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_name",
    "analysis_version",
    "domain",
    "capability",
    "input_provenance",
    "sip_registration_inventory",
    "registration_attempts",
    "diameter_ims_inventory",
    "cross_protocol_associations",
    "timeline",
    "completeness",
    "limitations",
    "not_confirmed"
  ],
  "properties": {
    "analysis_name": {
      "const": "ims-registration"
    },
    "analysis_version": {
      "const": "1.1.0"
    },
    "domain": {
      "const": "domain"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "input_provenance": {
      "$ref": "#/$defs/input_provenance"
    },
    "sip_registration_inventory": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/registration_transaction"
      }
    },
    "registration_attempts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/registration_attempt"
      }
    },
    "diameter_ims_inventory": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/diameter_observation"
      }
    },
    "cross_protocol_associations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/cross_protocol_association"
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    },
    "not_confirmed": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "reference_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_status",
        "implemented",
        "not_implemented",
        "interface_identity",
        "cross_protocol_association_policy"
      ],
      "properties": {
        "capability_status": {
          "const": "IMS_REGISTRATION_DOMAIN_IMPLEMENTED"
        },
        "implemented": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "not_implemented": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "interface_identity": {
          "const": "UNPROVED"
        },
        "cross_protocol_association_policy": {
          "const": "FAIL_CLOSED_WITHOUT_IDENTITY_BRIDGE"
        }
      }
    },
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sip_inputs",
        "diameter_artifact",
        "diameter_status",
        "common_capture_verified",
        "capture_identity_basis",
        "capture_identities",
        "diameter_capture_identities"
      ],
      "properties": {
        "sip_inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_name",
              "source_sha256",
              "input_format",
              "decoder",
              "event_count",
              "transaction_count"
            ],
            "properties": {
              "source_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "input_format": {
                "type": "string",
                "enum": [
                  "capture",
                  "pdml",
                  "fields-jsonl"
                ]
              },
              "decoder": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "event_count": {
                "type": "integer",
                "minimum": 0
              },
              "transaction_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "diameter_artifact": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_name",
                "source_sha256",
                "analysis_name",
                "analysis_version",
                "observation_count"
              ],
              "properties": {
                "source_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "analysis_name": {
                  "const": "diameter-ims"
                },
                "analysis_version": {
                  "type": "string",
                  "maxLength": 40
                },
                "observation_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "diameter_status": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "NOT_OBSERVED_IN_SUPPLIED_ARTIFACT",
            "NOT_SUPPLIED",
            "AMBIGUOUS",
            "CONFLICTING"
          ]
        },
        "common_capture_verified": {
          "const": false
        },
        "capture_identity_basis": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "capture_identities": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "diameter_capture_identities": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "registration_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_reference",
        "transaction_method",
        "transaction_state",
        "observed_evidence_status",
        "matching_status",
        "request_event_references",
        "provisional_response_event_references",
        "final_response_event_references",
        "response_event_references",
        "final_response_status_codes",
        "first_observed_frame",
        "last_observed_frame",
        "capture_identity",
        "retransmission_event_references",
        "omitted_request_event_count",
        "omitted_final_response_event_count",
        "missing_evidence",
        "conflict_findings",
        "limitations",
        "evidence_class"
      ],
      "properties": {
        "transaction_reference": {
          "$ref": "#/$defs/reference"
        },
        "transaction_method": {
          "const": "REGISTER"
        },
        "transaction_state": {
          "type": "string",
          "maxLength": 40
        },
        "observed_evidence_status": {
          "type": "string",
          "maxLength": 40
        },
        "matching_status": {
          "type": "string",
          "maxLength": 40
        },
        "request_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "provisional_response_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "final_response_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "response_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "final_response_status_codes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 699
          }
        },
        "first_observed_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "last_observed_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "capture_identity": {
          "type": "string",
          "maxLength": 240
        },
        "retransmission_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "omitted_request_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_final_response_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "conflict_findings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        },
        "evidence_class": {
          "const": "DERIVED"
        }
      }
    },
    "missing_list": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "enum": [
          "CALL_ID_NOT_OBSERVED",
          "FROM_TAG_NOT_OBSERVED",
          "CSEQ_NOT_OBSERVED",
          "REQUEST_URI_NOT_OBSERVED",
          "DIAMETER_ARTIFACT_NOT_SUPPLIED",
          "COMMON_CAPTURE_NOT_VERIFIED",
          "SUBSCRIBER_IDENTITY_BRIDGE_UNAVAILABLE",
          "FINAL_RESPONSE_NOT_OBSERVED",
          "REQUEST_NOT_OBSERVED",
          "AUTHORIZATION_NOT_OBSERVED",
          "CHALLENGE_NOT_OBSERVED",
          "EXPIRATION_NOT_OBSERVED",
          "CAPTURE_TRUNCATED"
        ]
      }
    },
    "conflict_list": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "enum": [
          "CALL_ID_MISMATCH",
          "FROM_TAG_MISMATCH",
          "REQUEST_URI_MISMATCH",
          "CSEQ_INCOMPATIBLE",
          "MULTIPLE_RETRY_CANDIDATES",
          "DIAMETER_PROVENANCE_CONFLICT",
          "UNSUPPORTED_CROSS_PROTOCOL_CLASS",
          "AUTHORIZATION_PRECEDED_CHALLENGE",
          "WRONG_AUTHORIZATION_TYPE",
          "INVALID_DEREGISTRATION_REQUEST",
          "WILDCARD_WITHOUT_EXPIRES",
          "WILDCARD_WITH_NONZERO_EXPIRES",
          "WILDCARD_WITH_ADDITIONAL_CONTACT",
          "WILDCARD_DUPLICATE_CONTACT",
          "WILDCARD_WITH_MALFORMED_EXPIRES",
          "CONTACT_BOUNDARY_UNRESOLVED",
          "EXPIRES_MALFORMED",
          "CONTACT_EXPIRES_MALFORMED",
          "CONTACT_EXPIRATION_OVERRIDES_EXPIRES",
          "EXPIRES_WITHOUT_CONTACT",
          "CHALLENGE_RESPONSE_NOT_BEFORE_RETRY",
          "CHALLENGE_RESPONSE_NOT_AFTER_REQUEST",
          "CHALLENGE_RESPONSE_REFERENCE_UNVERIFIED",
          "CHALLENGE_RESPONSE_STATUS_MISMATCH",
          "CAPTURE_IDENTITY_MISMATCH"
        ]
      }
    },
    "registration_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_reference",
        "capture_identity",
        "registration_type",
        "registration_type_evidence",
        "authentication_evidence_status",
        "authentication_cryptographically_verified",
        "sip_outcome",
        "transaction_references",
        "request_event_references",
        "response_event_references",
        "challenge_event_references",
        "retry_event_references",
        "final_response_event_references",
        "source_frame_references",
        "deregistration",
        "min_expires_evidence",
        "multi_hop_candidate",
        "cseq_observations",
        "omitted_transaction_count",
        "omitted_request_event_count",
        "omitted_response_event_count",
        "missing_evidence",
        "conflict_findings",
        "limitations",
        "not_confirmed",
        "evidence_class",
        "challenge_retry_association",
        "omitted_challenge_event_count",
        "omitted_retry_event_count",
        "omitted_final_response_event_count",
        "omitted_source_frame_count"
      ],
      "properties": {
        "attempt_reference": {
          "type": "string",
          "pattern": "^sip-registration:.+:[0-9]+\\.[0-9]+$",
          "maxLength": 300
        },
        "capture_identity": {
          "type": "string",
          "maxLength": 240
        },
        "registration_type": {
          "type": "string",
          "enum": [
            "INITIAL_REGISTRATION_CANDIDATE",
            "INITIAL_REGISTRATION_SUPPORTED",
            "RE_REGISTRATION_CANDIDATE",
            "REFRESH_OBSERVED",
            "DEREGISTRATION_REQUESTED",
            "UNDETERMINED"
          ]
        },
        "registration_type_evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "authentication_evidence_status": {
          "type": "string",
          "enum": [
            "NOT_OBSERVED",
            "CHALLENGE_OBSERVED",
            "RETRY_OBSERVED",
            "CHALLENGE_RETRY_ASSOCIATED",
            "CHALLENGE_WITHOUT_OBSERVED_RETRY",
            "RETRY_WITHOUT_OBSERVED_CHALLENGE",
            "AUTHENTICATION_OUTCOME_UNPROVED",
            "RETRY_NOT_ESTABLISHED"
          ]
        },
        "authentication_cryptographically_verified": {
          "const": false
        },
        "sip_outcome": {
          "type": "string",
          "enum": [
            "SUCCESS_RESPONSE_OBSERVED",
            "NEGATIVE_RESPONSE_OBSERVED",
            "OPEN_IN_CAPTURE",
            "AMBIGUOUS",
            "INCOMPLETE_EVIDENCE"
          ]
        },
        "transaction_references": {
          "$ref": "#/$defs/reference_list"
        },
        "request_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "response_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "challenge_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "retry_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "final_response_event_references": {
          "$ref": "#/$defs/reference_list"
        },
        "source_frame_references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "deregistration": {
          "anyOf": [
            {
              "$ref": "#/$defs/deregistration"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_expires_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "seconds"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "multi_hop_candidate": {
          "type": "boolean"
        },
        "cseq_observations": {
          "$ref": "#/$defs/cseq"
        },
        "omitted_transaction_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_request_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_response_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence": {
          "$ref": "#/$defs/missing_list"
        },
        "conflict_findings": {
          "$ref": "#/$defs/conflict_list"
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        },
        "not_confirmed": {
          "$ref": "#/$defs/limitations"
        },
        "evidence_class": {
          "const": "DERIVED"
        },
        "challenge_retry_association": {
          "anyOf": [
            {
              "$ref": "#/$defs/challenge_retry_association"
            },
            {
              "type": "null"
            }
          ]
        },
        "omitted_challenge_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_retry_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_final_response_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_source_frame_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_observed",
        "response_observed",
        "accepted_by_sip",
        "outcome",
        "expires_seconds",
        "contact_expires_seconds",
        "contact_wildcard",
        "scope",
        "valid_all_bindings_request",
        "contact_non_wildcard",
        "invalidity"
      ],
      "properties": {
        "request_observed": {
          "type": "boolean"
        },
        "response_observed": {
          "type": "boolean"
        },
        "accepted_by_sip": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "DEREGISTRATION_REQUEST_OBSERVED",
            "DEREGISTRATION_RESPONSE_OBSERVED",
            "DEREGISTRATION_ACCEPTED_BY_SIP",
            "DEREGISTRATION_OUTCOME_UNPROVED"
          ]
        },
        "expires_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "contact_expires_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "contact_wildcard": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "enum": [
            "ALL_BINDINGS",
            "CONTACT_SCOPED",
            "NONE"
          ]
        },
        "valid_all_bindings_request": {
          "type": "boolean"
        },
        "contact_non_wildcard": {
          "type": "boolean"
        },
        "mixed_contact_expiration": {
          "type": "boolean"
        },
        "contact_expiration_complete": {
          "type": "boolean"
        },
        "contact_entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_zero_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_positive_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_without_explicit_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_malformed_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "transaction_observations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/deregistration_transaction_observation"
          }
        },
        "omitted_transaction_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalidity": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "WILDCARD_WITHOUT_EXPIRES",
              "WILDCARD_WITH_NONZERO_EXPIRES",
              "WILDCARD_WITH_ADDITIONAL_CONTACT",
              "WILDCARD_DUPLICATE_CONTACT",
              "WILDCARD_WITH_MALFORMED_EXPIRES",
              "CONTACT_BOUNDARY_UNRESOLVED",
              "EXPIRES_MALFORMED",
              "CONTACT_EXPIRES_MALFORMED",
              "CONTACT_EXPIRATION_OVERRIDES_EXPIRES",
              "EXPIRES_WITHOUT_CONTACT",
              "INVALID_DEREGISTRATION_REQUEST"
            ]
          }
        }
      }
    },
    "deregistration_transaction_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_reference",
        "request_event_reference",
        "scope",
        "valid_all_bindings_request",
        "request_valid",
        "removal_request",
        "mixed_contact_expiration",
        "contact_expiration_complete",
        "contact_entry_count",
        "contact_zero_expires_count",
        "contact_positive_expires_count",
        "contact_without_explicit_expires_count",
        "contact_malformed_expires_count",
        "response_event_reference",
        "response_code",
        "response_observed",
        "accepted_by_sip",
        "outcome",
        "invalidity",
        "missing_evidence"
      ],
      "properties": {
        "transaction_reference": {
          "$ref": "#/$defs/reference"
        },
        "request_event_reference": {
          "$ref": "#/$defs/reference"
        },
        "scope": {
          "type": "string",
          "enum": [
            "ALL_BINDINGS",
            "CONTACT_SCOPED",
            "NONE"
          ]
        },
        "valid_all_bindings_request": {
          "type": "boolean"
        },
        "request_valid": {
          "type": "boolean"
        },
        "removal_request": {
          "type": "boolean"
        },
        "mixed_contact_expiration": {
          "type": "boolean"
        },
        "contact_expiration_complete": {
          "type": "boolean"
        },
        "contact_entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_zero_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_positive_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_without_explicit_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_malformed_expires_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "contact_boundary_status": {
          "type": "string",
          "enum": [
            "EXACT_ENTRY_VALUES",
            "HEADER_OCCURRENCE_ONLY",
            "NO_CONTACT",
            "UNRESOLVED",
            "UNAVAILABLE"
          ]
        },
        "contact_wildcard_boundary": {
          "type": "string",
          "enum": [
            "NONE",
            "SOLE",
            "MIXED",
            "DUPLICATE",
            "MALFORMED",
            "UNRESOLVED"
          ]
        },
        "response_event_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sip-event:.+:[0-9]+\\.[0-9]+$"
        },
        "response_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 699
        },
        "response_observed": {
          "type": "boolean"
        },
